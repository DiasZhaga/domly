{
    "info": {
        "name": "Domly-Content-Ads-Tests",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Create Ad - Missing Cookie (Negative)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Security: Ad creation rejected without Session Cookie (401)\", function () {",
                            "    pm.response.to.have.status(401);",
                            "});",
                            "pm.test(\"System stability: No internal server error (500)\", function () {",
                            "    pm.response.to.not.have.status(500);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "photos",
                            "type": "file",
                            "src": "../data/dummy.txt"
                        }
                    ]
                },
                "url": {
                    "raw": "http://localhost:8080/api/v1/content/ads",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "v1",
                        "content",
                        "ads"
                    ]
                }
            }
        },
        {
            "name": "Create Ad - Empty Payload (Negative)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Validation: Empty payload triggers Bad Request (400)\", function () {",
                            "    pm.response.to.have.status(400);",
                            "});",
                            "pm.test(\"System stability: No internal server error (500)\", function () {",
                            "    pm.response.to.not.have.status(500);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Cookie",
                        "value": "session_token=b7b6a1f4-327b-4265-ae38-4916600e7101",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": []
                },
                "url": {
                    "raw": "http://localhost:8080/api/v1/content/ads",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8080",
                    "path": [
                        "api",
                        "v1",
                        "content",
                        "ads"
                    ]
                }
            }
        }
    ]
}